{
  "name": "protoledger-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:mock": "NUXT_PUBLIC_DATA_SOURCE=mock nuxt dev",
    "dev:live": "NUXT_PUBLIC_DATA_SOURCE=live nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate && node scripts/externalize-inline-scripts.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "api:gen": "openapi-typescript ${API_SPEC:-../backend/openapi.yaml} -o app/api/schema.d.ts",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.3",
    "@pinia/nuxt": "^1.0.2",
    "nuxt": "~4.6.0",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.142",
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.6",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
